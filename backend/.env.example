# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB ─────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-char-hex-secret>

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_<your-resend-api-key>
FROM_EMAIL=onboarding@resend.dev
FROM_NAME="OMVIK CRM"

# ─── OTP Password Reset ──────────────────────────────────────
# ALL password reset OTPs are emailed to this address (admin inbox).
# The admin then relays the 6-digit code to the requesting employee.
# Change this in Render env vars — no code redeploy needed.
OTP_RECIPIENT_EMAIL=omvikrealcon@gmail.com

# ─── Admin Alerts (general) ──────────────────────────────────
ADMIN_ALERT_EMAIL=omvikrealcon@gmail.com
TO_EMAIL=omvikrealcon@gmail.com

# ─── SMTP fallback (if not using Resend) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=<gmail-app-password>

# ─── Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>

# ─── Cron / Testing ──────────────────────────────────────────
# Set to 'true' to use short reminder offsets for testing (30s/60s/2min)
# NEVER set to true in production
TEST_REMINDER_OFFSETS=false
